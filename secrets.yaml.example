# Copy this file to secrets.yaml (which is gitignored) and fill in your
# own values. Never commit secrets.yaml.

wifi_ssid: "YourWifiSSID"
wifi_password: "YourWifiPassword"

# Password for the fallback WiFi AP the device starts if it can't join
# your network (used by the captive portal). Minimum 8 characters.
ap_fallback_password: "changeme123"

# Generate with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# or use the "Generate Key" option in the ESPHome dashboard.
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Password for OTA firmware updates.
ota_password: "REPLACE_WITH_A_STRONG_PASSWORD"
