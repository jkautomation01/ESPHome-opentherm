{
  "name": "opentherm-thermostat-dial-card",
  "type": "module",
  "version": "1.0.0",
  "description": "Round-dial thermostat card for the ESPHome OpenTherm project (hot water, window, fault and mode badges) — forked from thermostat-dark-card by Marius Ciotlos",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards",
    "thermostat",
    "opentherm"
  ],
  "module": "opentherm-thermostat-dial-card.js",
  "repository": "https://github.com/jkautomation01/ESPHome-opentherm",
  "author": "Forked from thermostat-dark-card (Marius Ciotlos <ciotlos@gmail.com>)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "home-assistant-js-websocket": "^9.6.0",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "terser": "^5.49.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && cp demo/index.html dist/demo.html",
    "preview": "vite preview --port 4000 --host 0.0.0.0",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
